# Mẫu biến cho docker-compose.yml: chép thành file .env cùng thư mục rồi điền mật khẩu tự đặt.
# Không commit .env (đã có trong .gitignore). Mật khẩu chỉ áp ở lần chạy đầu; đổi sau đó thì chạy docker compose down -v.

# Mật khẩu root của MySQL trong container, cũng là tài khoản chạy Flyway
DB_MIGRATION_PASSWORD=
# Mật khẩu tài khoản eldercare_app (ứng dụng)
DB_PASSWORD=
# Mật khẩu tài khoản eldercare_retention (job loại bỏ dữ liệu hết hạn)
DB_RETENTION_PASSWORD=
